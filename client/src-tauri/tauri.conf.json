{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lan Party Monitor Client",
  "version": "0.1.0",
  "identifier": "com.lanpulse.client",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lan Party Monitor Client",
        "width": 920,
        "height": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
